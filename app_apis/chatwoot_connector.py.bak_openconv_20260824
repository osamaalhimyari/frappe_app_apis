@frappe.whitelist()
def test_connection(connector: str | None = None) -> dict:
	"""Prove the domain, account id and token work. Sends nothing.

	Run this first after filling in the settings -- every other failure in this
	module is easier to read once this one passes.

	`connector` picks which one to test: "1", "2", or blank for whichever is
	live. That lets connector 2 be validated while connector 1 is still the one
	sending -- try the new route, then switch to it. When connector 2 is in
	webhook mode there is nothing to call until a message is sent, so this just
	confirms a URL is set and says so.
	"""
	frappe.only_for("System Manager")

	settings = _settings_for(connector)

	if settings.get("method") == "webhook":
		if not settings.get("webhook_url"):
			return _fail(-400, _("Connector 2 Webhook URL is not set."))
		return {
			"ok": True,
			"connector": "2",
			"method": "webhook",
			"enabled": settings["enabled"],
			"webhook_url_set": True,
			"webhook_secret_set": bool(settings.get("webhook_secret")),
			"note": _("Webhook mode calls nothing until a message is sent. "
			          "Send to a number you control to verify the relay end to end."),
		}

	# The enabled flag gates *sending*, not diagnosing: an operator has to be
	# able to test the credentials before switching the connection on.
	for check in (settings["base_url"], settings["account_id"], _token(settings)):
		if not check:
			return _fail(-400, _("Domain, Account ID and API Token must all be set."))

	data, meta = _request("GET", "/inboxes", settings)
	if data is None:
		return _fail(*meta["error"], meta)

	inboxes = _payload(data) or []
	return {
		"ok": True,
		"connector": settings.get("connector"),
		"method": settings.get("method"),
		"enabled": settings["enabled"],
		"account_id": settings["account_id"],
		"inbox_count": len(inboxes),
		"inbox_id_configured": settings["inbox_id"],
		"inbox_id_valid": any(str(i.get("id")) == settings["inbox_id"] for i in inboxes),
		"_chatwoot": meta,
	}


@frappe.whitelist()
def list_inboxes(connector: str | None = None) -> dict:
	"""Every inbox on the account, so an inbox id can be filled in.

	The inbox decides which channel a message physically goes out on, and
	Chatwoot's UI buries the numeric id, so this is the practical way to find
	it. `connector` picks which one's account to read ("1"/"2"/blank=active);
	webhook mode has no inbox list to give.
	"""
	frappe.only_for("System Manager")

	settings = _settings_for(connector)
	if settings.get("method") == "webhook":
		return _fail(-400, _("Connector 2 is in webhook mode -- it has no Chatwoot inbox list. "
		                     "Switch its Method to agent_bot to list inboxes."))

	if not settings["base_url"] or not settings["account_id"] or not _token(settings):
		return _fail(-400, _("Domain, Account ID and API Token must all be set."))

	data, meta = _request("GET", "/inboxes", settings)
	if data is None:
		return _fail(*meta["error"], meta)

	return {
		"ok": True,
		"connector": settings.get("connector"),
		"inboxes": [
			{"id": i.get("id"), "name": i.get("name"), "channel": i.get("channel_type")}
			for i in (_payload(data) or [])
		],
	}


@frappe.whitelist()
def render_message(ticket: str, template: str = "valuation", lang: str | None = None) -> dict:
	"""The exact text that would be sent, without sending it.

	Whitelisted separately so a Client Script can show the operator a preview
	and let them confirm, rather than firing blind.
	"""
	if template not in TEMPLATES:
		return _fail(-400, _("Unknown message template: {0}").format(template))

	doc = frappe.get_doc("xticket", ticket)
	doc.check_permission("read")

	settings = active_settings()
	language = _language_for(doc, template, lang, settings)

	return {
		"ok": True,
		"ticket": doc.name,
		"template": template,
		"recipient": recipient_of(template),
		"lang": language,
		"phone": recipient_phone(doc, template),
		"message": _render(_template_text(template, language, settings), _context(doc, template, language)),
	}


@frappe.whitelist()
def render_both(ticket: str, template: str = "valuation") -> dict:
	"""One template in BOTH languages, sharing a single link.

	Drives the dialog on the ticket form, which shows the Arabic message, the
	English message and the bare link together. The link is built once and
	handed to both renders: rendering each language through its own call would
	mint two tokens a second apart, and the operator would be looking at three
	boxes carrying two different URLs.

	Rendering is not sending, so this deliberately does not require Chatwoot to
	be configured or enabled -- the messages come from the settings fields (or
	the built-in text) either way.
	"""
	if template not in TEMPLATES:
		return _fail(-400, _("Unknown message template: {0}").format(template))

	doc = frappe.get_doc("xticket", ticket)
	doc.check_permission("read")

	settings = active_settings()

	link_info = {}
	if template == "valuation":
		from app_apis.valuation import build_link

		link_info = build_link(doc.name)

	messages = {
		lang: _render(
			_template_text(template, lang, settings),
			_context(doc, template, lang, link=link_info.get("url")),
		)
		for lang in LANGUAGES
	}

	ready, why = _ready(settings)
	to = recipient_of(template)

	# A technician template has exactly one destination -- the engineer -- so
	# the dialog is offered that instead of the customer's numbers. Offering the
	# customer's list for a message addressed to the engineer is how somebody
	# sends a work order to the person who booked the job.
	if to == TO_TECHNICIAN:
		found = technicians.engineer(doc)
		phones = (
			[{"phone": found["phone"], "label": found["name"] or _("Engineer"),
			  "source": found["source"], "raw": found["phone"]}]
			if found["phone"] else []
		)
	else:
		phones = ticket_phones(doc)

	return {
		"ok": True,
		"ticket": doc.name,
		"template": template,
		"recipient": to,
		"state": doc.get("workflow_state") or "",
		"customer": doc.get("translated_customer_name") or doc.get("customer") or "",
		"engineer": technicians.name(doc),
		"phone": recipient_phone(doc, template),
		# Every candidate, so the dialog can offer a choice instead of silently
		# picking one -- and can tell the operator to type one when empty.
		"phones": phones,
		"messages": messages,
		# Which language a send would pick on its own, so a preview can show
		# the message that would actually go out rather than guessing.
		"default_lang": _language_for(doc, template, None, settings),
		"link": link_info.get("url", ""),
		"expires_on": link_info.get("expires_on", ""),
		"valid_hours": link_info.get("valid_hours", 0),
		# Rendering works with Chatwoot switched off; sending does not. Saying
		# so here lets a caller warn before the operator presses Send.
		"can_send": ready,
		"cannot_send_reason": why,
		# Which connector a Send would actually go through, so the dialog can
		# show the operator whether they are on the primary or the alternative.
		"connector": settings.get("connector"),
		"method": settings.get("method"),
	}


@frappe.whitelist()
def send_message(text: str, phone: str | None = None, conversation_id=None,
                 name: str | None = None, private: int = 0) -> dict:
	"""Post one message. The raw sender -- no ticket, no template.

	Give it either a `conversation_id` (post straight into a known thread) or a
	`phone` (find-or-create contact and conversation first). `private=1` writes
	an internal note the customer never sees, which is useful for logging an
	action against a thread.

	System Manager only. Arbitrary text to an arbitrary number is a much broader
	capability than "message this ticket's customer", so it is gated separately
	from `send_ticket_message`, which any agent who can read the ticket may use.
	"""
	frappe.only_for("System Manager")
	return _send(text, phone=phone, conversation_id=conversation_id, name=name, private=private)


def _send_via_webhook(text: str, phone: str | None, name: str | None, private,
                      conversation_id, settings: dict, context: dict | None) -> dict:
	"""Connector 2, webhook method: POST the rendered message to an outside URL.

	Chatwoot is never touched. The whole message -- text, destination, and
	whatever the caller knew about the ticket -- is handed to `webhook_url` as
	one JSON body, and it is that endpoint's job to deliver it (relay into
	Chatwoot as an admin, hit the WhatsApp Cloud API directly, whatever). Any
	2xx is treated as accepted; the relay owns delivery from there.

	The optional secret is sent in `webhook_auth_header`: as `Bearer <secret>`
	when that header is Authorization (the usual case), otherwise as the raw
	value, which suits an `X-Api-Key`-style header.
	"""
	import requests

	url = settings.get("webhook_url")
	if not url:
		return _fail(-400, _("Connector 2 Webhook URL is not set in App APIs settings."))

	destination = _normalise_phone(phone) if phone else None
	if phone and not destination:
		return _fail(-400, _("{0} is not a usable phone number.").format(phone))
	if not destination and not conversation_id:
		return _fail(-400, _("Either a phone number or a conversation id is required."))

	ctx = context or {}
	payload = {
		"event": "outgoing_message",
		"source": "app_apis.chatwoot_connector",
		"connector": "2",
		"method": "webhook",
		"ticket": ctx.get("ticket"),
		"template": ctx.get("template"),
		"lang": ctx.get("lang"),
		"customer": ctx.get("customer"),
		"name": name or ctx.get("customer") or "",
		"to": destination,
		"phone": destination or (phone or None),
		"raw_phone": phone or None,
		"conversation_id": conversation_id,
		"private": bool(cint(private)),
		"account_id": settings.get("account_id") or "",
		"inbox_id": settings.get("inbox_id") or "",
		"text": text,
	}

	headers = {"Content-Type": "application/json", "Accept": "application/json"}
	secret = settings.get("webhook_secret")
	hdr_name = settings.get("webhook_auth_header") or "Authorization"
	if secret:
		headers[hdr_name] = ("Bearer " + secret) if hdr_name.lower() == "authorization" else secret

	started = time.monotonic()
	try:
		resp = requests.post(url, json=payload, headers=headers, timeout=settings.get("timeout", 20))
	except requests.exceptions.Timeout:
		return _fail(-408, _("The webhook did not answer within {0}s.").format(settings.get("timeout", 20)))
	except requests.exceptions.RequestException as e:
		return _fail(-502, _("Could not reach the webhook: {0}").format(str(e)[:200]))

	meta = {
		"method": "POST",
		"url": url,
		"http_status": resp.status_code,
		"elapsed_ms": int((time.monotonic() - started) * 1000),
		"server_epoch": int(time.time()),
	}
	if resp.status_code >= 400:
		return _fail(-500, _("Webhook returned HTTP {0}: {1}").format(resp.status_code, resp.text[:300]), meta)

	message_id = None
	try:
		j = resp.json()
		if isinstance(j, dict):
			message_id = j.get("message_id") or j.get("id")
	except Exception:
		pass

	frappe.logger(LOGGER).warning(
		f"chatwoot(webhook): relayed to {url} ({len(text)} chars) -> HTTP {resp.status_code}"
	)

	return {
		"ok": True,
		"connector": "2",
		"method": "webhook",
		"webhook_status": resp.status_code,
		"conversation_id": conversation_id,
		"message_id": message_id,
		"phone": destination or phone,
		"message": text,
		"_chatwoot": meta,
	}


def _send(text: str, phone: str | None = None, conversation_id=None,
          name: str | None = None, private: int = 0, context: dict | None = None) -> dict:
	"""The actual send. Internal: callers decide who is allowed to reach it.

	Reads through `active_settings()`, so the live connector -- and, for
	connector 2, its method -- decides the route. `agent_api` (connector 1) and
	`agent_bot` (connector 2) share the REST chain below unchanged; `webhook`
	peels off to `_send_via_webhook`. `context` is optional ticket metadata that
	only the webhook payload uses; the REST path ignores it.
	"""
	settings = active_settings()
	ready, why = _ready(settings)
	if not ready:
		return _fail(-400, why)

	body_text = strip_html_tags(str(text or "")).strip()
	if not body_text:
		return _fail(-400, _("Refusing to send an empty message."))

	if settings.get("method") == "webhook":
		return _send_via_webhook(
			body_text, phone=phone, name=name, private=private,
			conversation_id=conversation_id, settings=settings, context=context,
		)

	if not conversation_id:
		if not phone:
			return _fail(-400, _("Either a phone number or a conversation id is required."))
		if not settings["inbox_id"]:
			return _fail(-400, _("Chatwoot Inbox ID is not set in App APIs settings."))

		destination = _normalise_phone(phone)
		if not destination:
			return _fail(-400, _("{0} is not a usable phone number.").format(phone))

		resolved = _resolve_conversation(destination, name or "", settings)
		if not resolved.get("ok"):
			return resolved
		conversation_id = resolved["conversation_id"]

	data, meta = _request("POST", f"/conversations/{conversation_id}/messages", settings, body={
		"content": body_text,
		"message_type": "outgoing",
		"private": bool(cint(private)),
	})
	if data is None:
		return _fail(*meta["error"], meta)

	frappe.logger(LOGGER).warning(
		f"chatwoot: sent to conversation {conversation_id} ({len(body_text)} chars)"
	)

	return {
		"ok": True,
		"connector": settings.get("connector"),
		"method": settings.get("method"),
		"conversation_id": conversation_id,
		"message_id": (_payload(data) or {}).get("id"),
		"message": body_text,
	}


@frappe.whitelist()
def send_ticket_message(ticket: str, template: str = "valuation", lang: str | None = None,
                        phone: str | None = None, text: str | None = None) -> dict:
	"""Send a ticket's message to its customer. The one scripts should call.

	Renders the ar/en template for the ticket, resolves the phone off the ticket
	(or its Customer) unless one is passed, and posts it. `text` overrides the
	template entirely, for a one-off message typed by an operator.

	Gated on read access to the ticket rather than on System Manager: the point
	of this function is that the agent working a ticket can message its
	customer. The destination still comes off the ticket, so read access is the
	honest permission -- whoever may see the customer's number may write to it.
	"""
	if template not in TEMPLATES:
		return _fail(-400, _("Unknown message template: {0}").format(template))

	doc = frappe.get_doc("xticket", ticket)
	doc.check_permission("read")

	settings = active_settings()
	ready, why = _ready(settings)
	if not ready:
		return _fail(-400, why)

	to = recipient_of(template)
	language = _language_for(doc, template, lang, settings)
	body_text = text or _render(_template_text(template, language, settings), _context(doc, template, language))

	destination = _normalise_phone(phone) if phone else recipient_phone(doc, template)
	if not destination:
		# Worth its own code: this is a data problem, not a Chatwoot problem,
		# and the two sides are fixed in different places -- so they get
		# different sentences rather than one vague one.
		if to == TO_TECHNICIAN:
			who = technicians.name(doc) or doc.get("assigned_to") or _("the engineer")
			return _fail(
				-404,
				_("No phone number on file for {0}. Add one to their User or Employee record.").format(who),
			)
		return _fail(-404, _("No usable phone number on ticket {0} or its customer.").format(ticket))

	context = {
		"ticket": doc.name,
		"template": template,
		"lang": language,
		"recipient": to,
		"customer": doc.get("translated_customer_name") or doc.get("customer") or "",
	}
	result = _send(body_text, phone=destination, name=recipient_name(doc, template), context=context)
	result["ticket"] = doc.name
	result["lang"] = language
	result["template"] = template
	result["recipient"] = to
	result["phone"] = destination
	# Only ever the engineer's own name, and only on a message addressed to
	# them -- so the log can say who was written to without the customer's row
	# picking up a staff name it has no business holding.
	result["engineer"] = technicians.name(doc) if to == TO_TECHNICIAN else ""
	return result


@frappe.whitelist()
def send_valuation_link(ticket: str, lang: str | None = None, phone: str | None = None) -> dict:
	"""Send the customer their 24-hour feedback link.

	A named shortcut for the `valuation` template, because this is the message
	the workflow actually wants and `send_ticket_message(ticket, "valuation")`
	is easy to typo into a silent status message.
	"""
	return send_ticket_message(ticket, template="valuation", lang=lang, phone=phone)


def status() -> dict:
	"""Configuration summary for the desk, with no secrets in it.

	Reports BOTH connectors and which one is live, so an operator running the
	two side by side can see at a glance which is ready and which is switched
	on. No token or secret is ever included -- only whether one is set.
	"""
	active = active_settings()
	ready, why = _ready(active)

	s1 = _settings_for("1")
	r1, w1 = _ready(s1)

	s2 = _settings_for("2")
	r2, w2 = _ready(s2)

	return {
		"active_connector": active.get("connector"),
		"active_method": active.get("method"),
		"ready": ready,
		"reason": why,
		"default_language": active["default_language"],
		"connector_1": {
			"enabled": s1["enabled"],
			"method": "agent_api",
			"base_url": s1["base_url"],
			"account_id": s1["account_id"],
			"inbox_id": s1["inbox_id"],
			"token_set": bool(_token(s1)),
			"ready": r1,
			"reason": w1,
		},
		"connector_2": {
			"enabled": s2["enabled"],
			"method": s2["method"],
			"base_url": s2["base_url"],
			"account_id": s2["account_id"],
			"inbox_id": s2["inbox_id"],
			"token_set": bool(_token(s2)),
			"webhook_url_set": bool(s2.get("webhook_url")),
			"webhook_secret_set": bool(s2.get("webhook_secret")),
			"ready": r2,
			"reason": w2,
		},
		"templates": sorted(TEMPLATES),
		"customer_templates": templates_for(TO_CUSTOMER),
		"technician_templates": templates_for(TO_TECHNICIAN),
	}
