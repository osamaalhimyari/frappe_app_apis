def _settings() -> dict:
	"""Chatwoot's section of the merged `app_apis` settings doctype.

	Every field is read under its `chatwoot_` prefix, for the same reason the
	Pilot and IM sections are prefixed: three connections share one Single, and
	unprefixed names like `base_url` would silently collide.
	"""
	s = frappe.get_cached_doc("app_apis")
	return {
		"enabled": bool(cint(s.chatwoot_enabled)),
		"base_url": _base_url(s.chatwoot_base_url),
		"account_id": str(s.chatwoot_account_id or "").strip(),
		"inbox_id": str(s.chatwoot_inbox_id or "").strip(),
		"timeout": cint(s.chatwoot_request_timeout) or 20,
		"default_language": (str(s.chatwoot_default_language or "").strip().lower() or "ar"),
		"doc": s,
	}


def _settings2() -> dict:
	"""The SECOND, alternative Chatwoot connection -- the `chatwoot2_` fields.

	Added alongside the primary so a site can keep the working connector wired
	up and try a different route without disturbing it. Connector 2 carries its
	own domain / account / inbox / token, and a `method`:

	    agent_bot -- talk to Chatwoot's REST API exactly as connector 1 does,
	                 but with the token below. Point it at an Agent Bot or an
	                 Administrator token and it can open conversations on any
	                 inbox, which is the thing an ordinary agent token cannot do.

	    webhook   -- do not touch Chatwoot at all. POST the rendered message to
	                 your own URL (n8n / Make / a small relay) and let that hand
	                 it to WhatsApp. Sidesteps Chatwoot's permissions entirely.

	Unlike connector 1 the token is resolved here (site_config `chatwoot2_*`
	wins over the field), so `_token` can hand it straight back without ever
	falling through to connector 1's secret.
	"""
	s = frappe.get_cached_doc("app_apis")

	method = (str(getattr(s, "chatwoot2_method", "") or "agent_bot").strip().lower())
	if method not in ("agent_bot", "webhook"):
		method = "agent_bot"

	conf_token = frappe.conf.get("chatwoot2_api_token")
	if conf_token:
		token = str(conf_token).strip() or None
	elif getattr(s, "chatwoot2_api_token", None):
		token = str(s.get_password("chatwoot2_api_token", raise_exception=False) or "").strip() or None
	else:
		token = None

	conf_secret = frappe.conf.get("chatwoot2_webhook_secret")
	if conf_secret:
		webhook_secret = str(conf_secret).strip() or None
	elif getattr(s, "chatwoot2_webhook_secret", None):
		webhook_secret = str(s.get_password("chatwoot2_webhook_secret", raise_exception=False) or "").strip() or None
	else:
		webhook_secret = None

	return {
		"connector": "2",
		"method": method,
		"enabled": bool(cint(getattr(s, "chatwoot2_enabled", 0))),
		"base_url": _base_url(getattr(s, "chatwoot2_base_url", "")),
		"account_id": str(getattr(s, "chatwoot2_account_id", "") or "").strip(),
		"inbox_id": str(getattr(s, "chatwoot2_inbox_id", "") or "").strip(),
		"token": token,
		"timeout": cint(getattr(s, "chatwoot2_request_timeout", 0)) or 20,
		"default_language": (str(s.chatwoot_default_language or "").strip().lower() or "ar"),
		"webhook_url": str(getattr(s, "chatwoot2_webhook_url", "") or "").strip(),
		"webhook_auth_header": (str(getattr(s, "chatwoot2_webhook_auth_header", "") or "").strip() or "Authorization"),
		"webhook_secret": webhook_secret,
		"doc": s,
	}


def _active_connector_id() -> str:
	"""Which connector is live: "1" (primary) or "2" (alternative)."""
	s = frappe.get_cached_doc("app_apis")
	return "2" if str(getattr(s, "chatwoot_active_connector", "") or "1").strip() == "2" else "1"


def active_settings() -> dict:
	"""The settings dict for whichever connector is switched on.

	Every send-path caller reads through this rather than `_settings()` so the
	choice of connector lives in exactly one place. Connector 1's shape is
	unchanged apart from the two label keys, so the REST chain below neither
	knows nor cares which connector it is serving.
	"""
	if _active_connector_id() == "2":
		return _settings2()
	base = _settings()
	base["connector"] = "1"
	base["method"] = "agent_api"
	return base


def _settings_for(connector: str | None) -> dict:
	"""Settings for a named connector ("1"/"2"), or the active one when blank.

	Lets `test_connection`/`list_inboxes` probe connector 2 while connector 1 is
	still the live one -- the whole point of running two side by side is to try
	the new route before committing to it.
	"""
	connector = str(connector or "").strip()
	if connector == "2":
		return _settings2()
	if connector == "1":
		base = _settings()
		base["connector"] = "1"
		base["method"] = "agent_api"
		return base
	return active_settings()


def _base_url(raw) -> str:
	"""Normalise whatever was typed into the domain field.

	Operators paste `chat.example.com`, `https://chat.example.com/` and
	`https://chat.example.com/app/accounts/1` interchangeably. Only the scheme
	and host matter here, and a trailing slash would produce `//api/v1`.
	"""
	url = str(raw or "").strip()
	if not url:
		return ""
	if not url.startswith(("http://", "https://")):
		url = "https://" + url
	return url.rstrip("/")


def _token(settings: dict) -> str | None:
	"""The Chatwoot API access token.

	`chatwoot_api_token` in site_config wins, so a deployment can keep the
	secret out of the database entirely; otherwise the encrypted field on
	app_apis. Same precedence as the IM password.

	Connector 2 resolves its own token up front into `settings["token"]` (see
	`_settings2`), so when that key is present it is returned verbatim and the
	connector-1 lookup below is skipped entirely -- the alternative connector
	must never silently borrow the primary's credentials.
	"""
	if settings.get("connector") == "2":
		return settings.get("token") or None

	conf_token = frappe.conf.get("chatwoot_api_token")
	if conf_token:
		return str(conf_token).strip()

	doc = settings["doc"]
	if not doc.chatwoot_api_token:
		return None

	# Stripped: a token pasted with a trailing newline produces an invalid
	# header value and a 401 that looks exactly like a wrong token.
	return str(doc.get_password("chatwoot_api_token") or "").strip() or None


def _ready(settings: dict) -> tuple[bool, str]:
	"""Is this connection usable? Returns (ok, reason).

	Serves both connectors and both of connector 2's methods. The webhook
	method needs only a URL; the REST methods (connector 1's agent_api and
	connector 2's agent_bot) need the domain / account / token as before.
	"""
	label = _("Chatwoot Connector 2") if settings.get("connector") == "2" else _("Chatwoot")

	if not settings["enabled"]:
		return False, _("{0} is not enabled in App APIs settings.").format(label)

	if settings.get("method") == "webhook":
		if not settings.get("webhook_url"):
			return False, _("Connector 2 Webhook URL is not set in App APIs settings.")
		return True, ""

	if not settings["base_url"]:
		return False, _("{0} Domain is not set in App APIs settings.").format(label)
	if not settings["account_id"]:
		return False, _("{0} Account ID is not set in App APIs settings.").format(label)
	if not _token(settings):
		return False, _("{0} API Token is not set in App APIs settings.").format(label)
	return True, ""


# --------------------------------------------------------------------------
# Layer 1: HTTP. Internal -- the browser cannot reach any of this.
# --------------------------------------------------------------------------


def _fail(code: int, msg: str, meta: dict | None = None) -> dict:
	"""A failure shaped like a success, so callers never branch on exceptions.

	NEGATIVE codes only, so they can never collide with an HTTP status:

	    -400 not configured / bad argument   -404 contact or inbox not found
	    -401 token rejected                  -408 timed out
	    -403 token lacks access to account   -502 could not connect
	                                         -500 unexpected response
	"""
	return {"ok": False, "code": code, "msg": msg, "_chatwoot": meta or {}}


def _meta(method: str, path: str, settings: dict) -> dict:
	return {
		"method": method,
		"path": path,
		"account_id": settings["account_id"],
		"inbox_id": settings["inbox_id"],
		"http_status": None,
		"elapsed_ms": 0,
		"server_epoch": int(time.time()),
	}


def _auth_headers(token: str | None) -> dict:
	"""Headers for one Chatwoot call, with the token sent BOTH ways.

	Chatwoot documents the header as `api_access_token`, but a header name
	containing underscores does not survive every hop. nginx drops them unless
	`underscores_in_headers on` is set, and VS Code dev tunnels drop them too --
	which is exactly how this surfaced: the same token that worked against
	Chatwoot directly came back 401 through a tunnel, because the header never
	arrived. The 401 is indistinguishable from a bad token, since Chatwoot
	answers "You need to sign in" for missing and invalid alike.

	Rack folds both spellings into the same HTTP_API_ACCESS_TOKEN, so sending
	the dashed form as well costs nothing and works through proxies that would
	otherwise silently strip the documented one.
	"""
	return {
		"api_access_token": token,
		"api-access-token": token,
		"Content-Type": "application/json",
		"Accept": "application/json",
	}


def _request(method: str, path: str, settings: dict, body: dict | None = None,
             params: dict | None = None) -> tuple[dict | list | None, dict]:
	"""One call to Chatwoot. Returns (decoded_body, meta) or (None, meta+error).

	The error path never raises -- when the first element is None the second
	always carries `error` as (code, msg). `path` is relative to the account,
	e.g. "/contacts/search".
	"""
	import requests

	meta = _meta(method, path, settings)
	token = _token(settings)

	url = f"{settings['base_url']}{API_ROOT}/accounts/{settings['account_id']}{path}"
	started = time.monotonic()

	try:
		resp = requests.request(
			method,
			url,
			headers=_auth_headers(token),
			json=body,
			params=params,
			timeout=settings["timeout"],
		)
		meta["elapsed_ms"] = int((time.monotonic() - started) * 1000)
		meta["http_status"] = resp.status_code

		if resp.status_code in (401, 403):
			meta["error"] = (
				-401 if resp.status_code == 401 else -403,
				_("Chatwoot rejected the API token (HTTP {0}).").format(resp.status_code),
			)
			return None, meta

		if resp.status_code == 404:
			meta["error"] = (-404, _("Chatwoot has no such record (HTTP 404): {0}").format(path))
			return None, meta

		if resp.status_code >= 400:
			meta["error"] = (
				-500,
				_("Chatwoot returned HTTP {0}: {1}").format(resp.status_code, resp.text[:300]),
			)
			return None, meta

		# 204 and friends carry no body; that is a success with nothing to read.
		if not (resp.text or "").strip():
			return {}, meta

		try:
			return resp.json(), meta
		except json.JSONDecodeError:
			meta["error"] = (-500, _("Chatwoot sent a non-JSON response: {0}").format(resp.text[:300]))
			return None, meta

	except requests.exceptions.Timeout:
		meta["elapsed_ms"] = int((time.monotonic() - started) * 1000)
		meta["error"] = (-408, _("Chatwoot did not answer within {0}s.").format(settings["timeout"]))
		return None, meta
	except requests.exceptions.RequestException as e:
		meta["elapsed_ms"] = int((time.monotonic() - started) * 1000)
		meta["error"] = (-502, _("Could not reach Chatwoot: {0}").format(str(e)[:200]))
		return None, meta


# --------------------------------------------------------------------------
# Layer 2: contacts and conversations
# --------------------------------------------------------------------------


def _payload(data):
	"""Chatwoot wraps most list/create results in `payload`. Unwrap defensively."""
	if isinstance(data, dict):
		inner = data.get("payload", data)
		return inner
	return data


def _find_contact(phone: str, settings: dict):
	"""The first Chatwoot contact whose phone matches, or None.

	Search is a fuzzy `q=`, so the result is filtered back down to an exact
	phone match -- otherwise a search for +966500000001 can return the contact
	for +966500000010 and the message goes to a stranger.
	"""
	data, meta = _request("GET", "/contacts/search", settings, params={"q": phone})
	if data is None:
		return None, meta

	for contact in _payload(data) or []:
		if _digits(contact.get("phone_number")) == _digits(phone):
			return contact, meta

	return None, meta


def _create_contact(phone: str, name: str, settings: dict):
	"""Create a contact already attached to the target inbox.

	Passing `inbox_id` here is what makes Chatwoot mint a contact_inbox (and so
	a source_id) in one call instead of two.
	"""
	body = {
		"inbox_id": cint(settings["inbox_id"]),
		"name": name or phone,
		"phone_number": phone,
	}
	data, meta = _request("POST", "/contacts", settings, body=body)
	if data is None:
		return None, meta

	contact = _payload(data) or {}
	# Create wraps the record one level deeper than search does.
	return contact.get("contact", contact), meta


def _source_id(contact: dict, settings: dict):
	"""The contact's source_id for the target inbox, minting one if needed.

	A contact that exists but has never been messaged on this inbox has no
	source_id for it, and creating a conversation without one fails.
	"""
	inbox_id = cint(settings["inbox_id"])

	for ci in contact.get("contact_inboxes") or []:
		if cint((ci.get("inbox") or {}).get("id") or ci.get("inbox_id")) == inbox_id:
			if ci.get("source_id"):
				return ci["source_id"], None

	data, meta = _request(
		"POST", f"/contacts/{contact['id']}/contact_inboxes", settings,
		body={"inbox_id": inbox_id},
	)
	if data is None:
		return None, meta

	return (_payload(data) or {}).get("source_id"), meta


def _open_conversation(contact_id, settings: dict):
	"""An existing conversation for this contact on this inbox, or None.

	Reused rather than replaced so a follow-up lands in the thread the agent is
	already reading. Resolved threads count: posting into one reopens it, which
	is the right behaviour for a ticket update.
	"""
	data, meta = _request("GET", f"/contacts/{contact_id}/conversations", settings)
	if data is None:
		return None, meta

	inbox_id = cint(settings["inbox_id"])
	for conv in _payload(data) or []:
		if cint(conv.get("inbox_id")) == inbox_id:
			return conv.get("id"), meta

	return None, meta


def _resolve_conversation(phone: str, name: str, settings: dict) -> dict:
	"""Find-or-create the conversation to post into.

	Returns {"ok": True, "conversation_id": .., "contact_id": ..} or a _fail().
	"""
	contact, meta = _find_contact(phone, settings)
	if contact is None and meta.get("error"):
		return _fail(*meta["error"], meta)

	if not contact:
		contact, meta = _create_contact(phone, name, settings)
		if contact is None:
			return _fail(*meta.get("error", (-500, _("Could not create the Chatwoot contact."))), meta)

	if not contact.get("id"):
		return _fail(-500, _("Chatwoot returned a contact with no id."), meta)

	conversation_id, meta = _open_conversation(contact["id"], settings)
	if conversation_id:
		return {"ok": True, "conversation_id": conversation_id, "contact_id": contact["id"], "created": False}

	source_id, sid_meta = _source_id(contact, settings)
	if not source_id:
		err = (sid_meta or {}).get("error") or (-500, _("Could not obtain a Chatwoot source id for this inbox."))
		return _fail(*err, sid_meta or {})

	data, meta = _request("POST", "/conversations", settings, body={
		"source_id": source_id,
		"inbox_id": cint(settings["inbox_id"]),
		"contact_id": contact["id"],
	})
	if data is None:
		return _fail(*meta.get("error", (-500, _("Could not open a Chatwoot conversation."))), meta)

	conversation_id = (_payload(data) or {}).get("id")
	if not conversation_id:
		return _fail(-500, _("Chatwoot opened a conversation with no id."), meta)

	return {"ok": True, "conversation_id": conversation_id, "contact_id": contact["id"], "created": True}


# --------------------------------------------------------------------------
# Phone numbers, language, and template rendering
# --------------------------------------------------------------------------


# Both now live in app_apis.phone, so the technician side normalises numbers by
# exactly the same rule this side does. Kept under their old private names so
# the rest of this module reads unchanged.
_digits = digits
_normalise_phone = normalise


def ticket_phones(doc) -> list[dict]:
	"""Every usable number on a ticket, best first, deduped.

	Returned as a list rather than a single best guess so the operator can pick:
	`driver_mobile` and `driver_mobile2` hold the same value on essentially
	every ticket, but `issue_mobile` is often a different person, and choosing
	wrongly means messaging a stranger about someone else's vehicle.

	Each row carries the field's own label from the ticket, so the dialog says
	"Mobile No" -- what the operator sees on the form -- rather than a fieldname.
	"""
	meta = frappe.get_meta("xticket")
	seen, found = set(), []

	for field in TICKET_PHONE_FIELDS:
		phone = _normalise_phone(doc.get(field))
		if not phone or phone in seen:
			continue
		seen.add(phone)
		found.append({
			"phone": phone,
			"label": meta.get_label(field) or field,
			"source": field,
			"raw": str(doc.get(field) or ""),
		})

	# The Customer's own number backs the ticket up: it is set on about half the
	# customers and is often the only number for a ticket raised by phone.
	if doc.get("customer"):
		raw = frappe.db.get_value("Customer", doc.customer, "mobile_no")
		phone = _normalise_phone(raw)
		if phone and phone not in seen:
			found.append({
				"phone": phone,
				"label": _("Customer Mobile"),
				"source": "customer.mobile_no",
				"raw": str(raw or ""),
			})

	return found


def ticket_phone(doc) -> str | None:
	"""The best phone number on a ticket, or None."""
	phones = ticket_phones(doc)
	return phones[0]["phone"] if phones else None


def _language(doc, requested, settings: dict) -> str:
	"""Which language to write in.

	An explicit argument wins, then the Customer's own `language` (set to `ar`
	on essentially every customer here), then the configured default.
	"""
	requested = str(requested or "").strip().lower()[:2]
	if requested in LANGUAGES:
		return requested

	if doc is not None and doc.get("customer"):
		customer_lang = str(frappe.db.get_value("Customer", doc.customer, "language") or "")[:2].lower()
		if customer_lang in LANGUAGES:
			return customer_lang

	default = settings["default_language"][:2]
	return default if default in LANGUAGES else "ar"


def _language_for(doc, template: str, requested, settings: dict) -> str:
	"""Which language to write THIS template in.

	A technician message is staff-facing, so the customer's own `language` has
	no bearing on it -- an engineer does not start reading English because the
	company they are visiting does. Passing `doc=None` skips that lookup and
	leaves an explicit argument, then the configured default, deciding.
	"""
	if recipient_of(template) == TO_TECHNICIAN:
		return _language(None, requested, settings)
	return _language(doc, requested, settings)


def recipient_phone(doc, template: str) -> str | None:
	"""The number this template should go to, or None if nobody recorded one."""
	if recipient_of(template) == TO_TECHNICIAN:
		return technicians.phone(doc)
	return ticket_phone(doc)


def recipient_name(doc, template: str) -> str:
	"""The name Chatwoot should file the contact under."""
	if recipient_of(template) == TO_TECHNICIAN:
		return technicians.name(doc)
	return doc.get("translated_customer_name") or doc.get("customer") or ""


# Labels for the placeholders that render as a whole line. Same idea as the
# vehicle label in app_apis/vehicle.py: a built-in, and an operator who wants
# different wording writes their own line around the bare value instead.
LINE_LABELS = {
	"location": {"ar": "📍 الموقع", "en": "📍 Location"},
	"phone": {"ar": "📞 رقم التواصل", "en": "📞 Contact"},
}

# Where the job actually is, best first. All three are plain display strings on
# the ticket; whichever is filled is the one worth putting in a work order.
TICKET_LOCATION_FIELDS = ("installation_location", "city_text", "city")

# A work order is read on a phone. Enough for an address, not enough for
# somebody to have pasted an essay into the field.
MAX_LOCATION = 160


def _location(doc) -> str:
	for field in TICKET_LOCATION_FIELDS:
		value = strip_html_tags(str(doc.get(field) or "")).strip()
		if value:
			return value[:MAX_LOCATION]
	return ""


def _line(value: str, key: str, lang: str) -> str:
	""""📍 Location: Riyadh", or "" when there is nothing to say."""
	if not value:
		return ""
	label = LINE_LABELS[key][lang if lang in LANGUAGES else "ar"]
	return f"{label}: {value}"


def _context(doc, template: str, lang: str = "ar", link: str | None = None) -> dict:
	"""Placeholder values for a ticket.

	Kept flat and string-only: these are pasted into a message, not used for
	logic, and a None reaching the customer as "None" is the failure worth
	preventing.
	"""
	to = recipient_of(template)

	ctx = {
		"ticket": doc.name,
		"state": doc.get("workflow_state") or doc.get("status") or "",
		"customer": doc.get("translated_customer_name") or doc.get("customer") or "",
		# `technician` on the right is the xticket's own fieldname -- that
		# doctype belongs to the site, not this app, so it keeps its name even
		# though the role is called the installation engineer everywhere here.
		"engineer": technicians.name(doc),
		# Both read through app_apis.vehicle, which picks the plate written in
		# THIS language -- Saudi plates carry Arabic and Latin forms of the same
		# number. {vehicle} is the whole line and is what the shipped templates
		# use; {plate} is the bare value, for an operator who wants to write
		# their own wording around it.
		#
		# The customer-type gate applies only on the customer's side. An
		# engineer is being told which vehicle to work on, and a company owning
		# it does not make that less true -- see vehicle.staff_line.
		"vehicle": vehicle_staff_line(doc, lang) if to == TO_TECHNICIAN else vehicle_line(doc, lang),
		"plate": vehicle_plate(doc, lang) if to == TO_TECHNICIAN else vehicle_for_customer(doc, lang),
		# Whole lines like {vehicle}, and empty when the ticket does not say --
		# a work order with "Location:" and nothing after it is worse than one
		# that does not mention location at all.
		"location": _line(_location(doc), "location", lang),
		"phone": _line(ticket_phone(doc) or "", "phone", lang),
		"company": frappe.defaults.get_user_default("Company") or "",
		"link": "",
		# Read from the settings child table, never hardcoded, so the numbers
		# can be changed from the desk or a script with no deploy.
		"contacts": format_contacts(lang),
	}

	# Imported lazily and only when the template asks for it: this module must
	# stay usable on a site where the valuation page was never deployed.
	#
	# A caller that is rendering the same message twice -- once per language --
	# passes the link in, so both copies carry the same token. Minting one per
	# render would hand the operator two links expiring seconds apart.
	if template == "valuation":
		if link is None:
			from app_apis.valuation import build_url

			link = build_url(doc.name)
		ctx["link"] = link

	return ctx


def _render(template_text: str, ctx: dict) -> str:
	"""Fill {placeholders} by plain replacement, then close any gap they left.

	Deliberately not str.format: the template is operator-editable text, and
	format() would turn a stray brace into a crash and expose attribute
	traversal on the values. Unknown placeholders are left visible so a typo
	shows up in the message instead of vanishing.

	Some placeholders are whole lines that are allowed to be empty -- {vehicle}
	for a company customer, {location} on a ticket that never recorded one,
	{contacts} on a site with no numbers configured. Rendering is therefore done
	a line at a time, and a line that had content in the template but came out
	completely empty is dropped rather than left as a blank gap. That is what
	lets the technician templates stack {vehicle} / {location} / {phone} as
	consecutive lines: whichever of them the ticket does not have simply is not
	there, instead of leaving a hole in the middle of a work order.

	A line only disappears if it vanished entirely. "Vehicle: {plate}" with no
	plate renders as "Vehicle:" and is kept -- silently eating wording an
	operator typed would be worse than a stray label, and it is their line to
	fix. A blank line they wrote themselves is likewise kept.

	The newline collapse afterwards is the paragraph case: {vehicle} written as
	its own paragraph leaves the blank line above AND below it, and those close
	back up to the single blank line the rest of the message uses.
	"""
	kept = []
	for line in str(template_text or "").split("\n"):
		filled = line
		for key, value in ctx.items():
			filled = filled.replace("{" + key + "}", str(value if value is not None else ""))
		if line.strip() and not filled.strip():
			continue
		kept.append(filled)

	# Trailing spaces first, or a line holding only a space survives as content
	# and the collapse below never sees the run of newlines it is looking for.
	text = re.sub(r"[ \t]+(?=\n)", "", "\n".join(kept))
	return re.sub(r"\n{3,}", "\n\n", text).strip()


def _template_text(template: str, lang: str, settings: dict) -> str:
	"""The configured text for this template and language, or the built-in."""
	spec = TEMPLATES[template]
	field = spec["ar_field"] if lang == "ar" else spec["en_field"]
	configured = str(settings["doc"].get(field) or "").strip()
	return configured or spec[lang]


