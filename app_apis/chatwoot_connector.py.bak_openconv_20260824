def recipient_of(template: str) -> str:
	"""Who a template is written to. Unknown templates are treated as the
	customer's -- the stricter of the two, since that side is filtered by
	customer type and this one is not."""
	return (TEMPLATES.get(template) or {}).get("to", TO_CUSTOMER)


def templates_for(to: str) -> list[str]:
	"""Template keys addressed to one audience, in declaration order."""
	return [key for key, spec in TEMPLATES.items() if spec.get("to", TO_CUSTOMER) == to]

