  "script": "// \"Valuation Link\" toolbar button for xticket.\n//\n// One dialog does everything an operator needs to ask a customer for feedback:\n//   - the Arabic message, the English message, and the bare link, all editable\n//   - a number picked from the ticket, or typed in when the ticket has none\n//   - copy buttons for pasting anywhere, and Send for going straight to Chatwoot\n//\n// The three boxes come from ONE server call on purpose. The message text lives\n// in App APIs -> Chatwoot Messages, and the link is minted once and pasted into\n// both languages -- rendering each language separately would give the operator\n// three boxes carrying two different tokens, expiring seconds apart.\n//\n// The link is public by design -- it carries a signed token instead of\n// requiring an account -- so \"Open as Customer\" shows exactly what the customer\n// sees. Open it in a private window to prove it works with no session at all.\n//\n// Every press mints a fresh link that dies 24 hours later, so re-sending is\n// always safe: the customer gets a full day from the moment you hand it over.\n\n// Full international form: a leading +, a country code that cannot start with\n// zero, and 8-15 digits total. Deliberately strict -- Chatwoot accepts a local\n// number and simply never delivers it.\nconst E164 = /^\\+[1-9]\\d{7,14}$/;\n\nfrappe.ui.form.on(\"xticket\", {\n\trefresh(frm) {\n\t\tif (frm.is_new()) return;\n\n\t\tfrm.add_custom_button(__(\"Valuation Link\"), () => {\n\t\t\tfrappe.call({\n\t\t\t\tmethod: \"app_apis.chatwoot_connector.render_both\",\n\t\t\t\targs: { ticket: frm.doc.name, template: \"valuation\" },\n\t\t\t\tfreeze: true,\n\t\t\t\tfreeze_message: __(\"Building link…\"),\n\t\t\t\tcallback(r) {\n\t\t\t\t\tconst d = (r && r.message) || {};\n\n\t\t\t\t\tif (!d.ok) {\n\t\t\t\t\t\tfrappe.msgprint({\n\t\t\t\t\t\t\ttitle: __(\"Valuation Link\"),\n\t\t\t\t\t\t\tmessage: d.msg || __(\"Could not build the link.\"),\n\t\t\t\t\t\t\tindicator: \"red\",\n\t\t\t\t\t\t});\n\t\t\t\t\t\treturn;\n\t\t\t\t\t}\n\n\t\t\t\t\tshow_dialog(frm, d);\n\t\t\t\t},\n\t\t\t});\n\t\t});\n\t},\n});\n\nfunction clean_number(value) {\n\t// Spaces, dashes and brackets are how people write numbers; strip them\n\t// before judging the shape, and keep a leading + if there is one.\n\treturn String(value || \"\").replace(/[\\s\\-().]/g, \"\");\n}\n\nfunction show_dialog(frm, d) {\n\tconst OTHER = \"__other__\";\n\tconst has_phones = d.phones && d.phones.length > 0;\n\n\tconst copy = (value, what) => {\n\t\tif (!value) return;\n\t\tfrappe.utils.copy_to_clipboard(value);\n\t\tfrappe.show_alert({ message: __(\"{0} copied\", [what]), indicator: \"green\" });\n\t};\n\n\tconst fields = [\n\t\t{ fieldtype: \"HTML\", fieldname: \"info\" },\n\n\t\t{ fieldtype: \"Section Break\", label: __(\"Arabic Message\") },\n\t\t{\n\t\t\tfieldtype: \"Small Text\",\n\t\t\tfieldname: \"msg_ar\",\n\t\t\t// No label: the section heading already says which one this is,\n\t\t\t// and a label here just pushes the text down.\n\t\t\tdefault: d.messages.ar,\n\t\t},\n\t\t{\n\t\t\tfieldtype: \"Button\",\n\t\t\tfieldname: \"copy_ar\",\n\t\t\tlabel: __(\"Copy Arabic\"),\n\t\t\tclick: () => copy(dialog.get_value(\"msg_ar\"), __(\"Arabic message\")),\n\t\t},\n\n\t\t{ fieldtype: \"Section Break\", label: __(\"English Message\") },\n\t\t{ fieldtype: \"Small Text\", fieldname: \"msg_en\", default: d.messages.en },\n\t\t{\n\t\t\tfieldtype: \"Button\",\n\t\t\tfieldname: \"copy_en\",\n\t\t\tlabel: __(\"Copy English\"),\n\t\t\tclick: () => copy(dialog.get_value(\"msg_en\"), __(\"English message\")),\n\t\t},\n\n\t\t{ fieldtype: \"Section Break\", label: __(\"Link Only\") },\n\t\t{ fieldtype: \"Small Text\", fieldname: \"link\", default: d.link },\n\t\t{\n\t\t\tfieldtype: \"Button\",\n\t\t\tfieldname: \"copy_link\",\n\t\t\tlabel: __(\"Copy Link\"),\n\t\t\tclick: () => copy(dialog.get_value(\"link\"), __(\"Link\")),\n\t\t},\n\n\t\t{ fieldtype: \"Section Break\", label: __(\"Send via Chatwoot\") },\n\t\t{\n\t\t\tfieldtype: \"Select\",\n\t\t\tfieldname: \"pick\",\n\t\t\tlabel: __(\"Send to\"),\n\t\t\t// \"Other number…\" is always offered: the number on the ticket is\n\t\t\t// often the driver's, and whoever should rate the work is the\n\t\t\t// person the operator actually spoke to.\n\t\t\toptions: (d.phones || [])\n\t\t\t\t.map((p) => ({ value: p.phone, label: `${p.label} — ${p.phone}` }))\n\t\t\t\t.concat([{ value: OTHER, label: __(\"Other number…\") }]),\n\t\t\tdefault: has_phones ? d.phones[0].phone : OTHER,\n\t\t\tchange() {\n\t\t\t\tconst other = dialog.get_value(\"pick\") === OTHER;\n\t\t\t\tdialog.set_df_property(\"manual\", \"hidden\", !other);\n\t\t\t\tdialog.set_df_property(\"manual\", \"reqd\", other);\n\t\t\t\tif (other) dialog.fields_dict.manual.$input.focus();\n\t\t\t},\n\t\t},\n\t\t{\n\t\t\tfieldtype: \"Data\",\n\t\t\tfieldname: \"manual\",\n\t\t\tlabel: __(\"Mobile number\"),\n\t\t\tdescription: __(\n\t\t\t\t\"Full international form, including the country code — for example +966512345678.\"\n\t\t\t),\n\t\t\thidden: has_phones,\n\t\t\treqd: !has_phones,\n\t\t},\n\t\t{\n\t\t\tfieldtype: \"Select\",\n\t\t\tfieldname: \"lang\",\n\t\t\tlabel: __(\"Language\"),\n\t\t\toptions: [\n\t\t\t\t{ value: \"\", label: __(\"Automatic ({0})\", [d.default_lang]) },\n\t\t\t\t{ value: \"ar\", label: __(\"Arabic\") },\n\t\t\t\t{ value: \"en\", label: __(\"English\") },\n\t\t\t],\n\t\t\tdefault: \"\",\n\t\t},\n\t\t{\n\t\t\tfieldtype: \"Button\",\n\t\t\tfieldname: \"send\",\n\t\t\tlabel: __(\"Send Now\"),\n\t\t\tclick: () => do_send(frm, d, dialog, OTHER),\n\t\t},\n\t];\n\n\tconst dialog = new frappe.ui.Dialog({\n\t\ttitle: __(\"Valuation Link\"),\n\t\tsize: \"large\",\n\t\tfields: fields,\n\t\tprimary_action_label: __(\"Open as Customer\"),\n\t\tprimary_action() {\n\t\t\twindow.open(dialog.get_value(\"link\") || d.link, \"_blank\", \"noopener\");\n\t\t},\n\t});\n\n\tconst esc = (v) => frappe.utils.escape_html(String(v || \"—\"));\n\n\t// Worth being loud about when it is missing: about 40% of tickets carry no\n\t// usable number, and the operator should know before hunting for one.\n\tconst phone_note = has_phones\n\t\t? `<div><b>${__(\"Mobile\")}:</b> <span dir=\"ltr\">${esc(d.phones[0].phone)}</span>\n\t\t     <span style=\"color:var(--text-muted)\">(${esc(d.phones[0].label)})</span></div>`\n\t\t: `<div style=\"margin-top:8px;padding:8px 10px;border-radius:6px;\n\t\t            background:#fff7ed;border:1px solid #fed7aa\">\n\t\t     <b>${__(\"This ticket has no mobile number\")}</b> —\n\t\t     ${__(\"type one below before sending.\")}\n\t\t   </div>`;\n\n\tdialog.fields_dict.info.$wrapper.html(`\n\t\t<div style=\"font-size:13px;margin-bottom:10px\">\n\t\t\t<div><b>${__(\"Ticket\")}:</b> ${esc(d.ticket)}</div>\n\t\t\t<div><b>${__(\"Customer\")}:</b> ${esc(d.customer)}</div>\n\t\t\t${phone_note}\n\t\t\t<div style=\"margin-top:8px\">\n\t\t\t\t<span class=\"indicator-pill orange\">\n\t\t\t\t\t${__(\"Expires\")} ${esc(d.expires_on)}\n\t\t\t\t</span>\n\t\t\t\t${\n\t\t\t\t\td.can_send\n\t\t\t\t\t\t? \"\"\n\t\t\t\t\t\t: `<span class=\"indicator-pill red\" style=\"margin-inline-start:6px\">\n\t\t\t\t\t\t\t${__(\"Chatwoot not ready\")}</span>`\n\t\t\t\t}\n\t\t\t</div>\n\t\t\t<div style=\"margin-top:8px;color:var(--text-muted)\">\n\t\t\t\t${__(\n\t\t\t\t\t\"Message text comes from App APIs → Chatwoot Messages. Anyone with this link can open it without an account, and only for this ticket. It stops working after {0} hours — press the button again for a fresh one.\",\n\t\t\t\t\t[d.valid_hours || 24]\n\t\t\t\t)}\n\t\t\t</div>\n\t\t</div>\n\t`);\n\n\tdialog.show();\n\n\t// Arabic reads right-to-left, and a message reviewed in the wrong direction\n\t// is genuinely hard to proofread.\n\tdialog.fields_dict.msg_ar.$input.attr(\"dir\", \"rtl\");\n\tdialog.fields_dict.link.$input.attr(\"dir\", \"ltr\");\n\tdialog.fields_dict.manual.$input\n\t\t.attr(\"dir\", \"ltr\")\n\t\t.attr(\"placeholder\", \"+966512345678\");\n\n\t// Small Text defaults to three rows; these messages are longer than that.\n\tdialog.fields_dict.msg_ar.$input.attr(\"rows\", 8);\n\tdialog.fields_dict.msg_en.$input.attr(\"rows\", 8);\n\tdialog.fields_dict.link.$input.attr(\"rows\", 2);\n}\n\nfunction do_send(frm, d, dialog, OTHER) {\n\tif (!d.can_send) {\n\t\tfrappe.msgprint({\n\t\t\ttitle: __(\"Cannot send\"),\n\t\t\tmessage: d.cannot_send_reason || __(\"Chatwoot is not ready.\"),\n\t\t\tindicator: \"orange\",\n\t\t});\n\t\treturn;\n\t}\n\n\tconst picked = dialog.get_value(\"pick\");\n\tconst destination = clean_number(\n\t\t!picked || picked === OTHER ? dialog.get_value(\"manual\") : picked\n\t);\n\n\tif (!destination) {\n\t\tfrappe.msgprint({\n\t\t\ttitle: __(\"No number\"),\n\t\t\tmessage: __(\"Enter a mobile number first.\"),\n\t\t\tindicator: \"orange\",\n\t\t});\n\t\treturn;\n\t}\n\n\t// Checked here rather than trusted to the server: a number the server\n\t// \"fixes\" by guessing a country code is a message delivered to whoever\n\t// happens to own that number abroad.\n\tif (!E164.test(destination)) {\n\t\tfrappe.msgprint({\n\t\t\ttitle: __(\"Check the number\"),\n\t\t\tmessage: __(\n\t\t\t\t\"{0} is not a full international number. Include the country code, starting with + — for example +966512345678.\",\n\t\t\t\t[frappe.utils.escape_html(destination)]\n\t\t\t),\n\t\t\tindicator: \"red\",\n\t\t});\n\t\treturn;\n\t}\n\n\t// The operator may have edited the message in the box above, so send that\n\t// text rather than re-rendering the template server-side and quietly\n\t// discarding their edit.\n\tconst lang = dialog.get_value(\"lang\") || d.default_lang;\n\tconst text = lang === \"ar\" ? dialog.get_value(\"msg_ar\") : dialog.get_value(\"msg_en\");\n\n\tfrappe.confirm(\n\t\t__(\"Send this message to {0}?\", [`<b dir=\"ltr\">${destination}</b>`]),\n\t\t() => {\n\t\t\tfrappe.call({\n\t\t\t\tmethod: \"app_apis.chatwoot_connector.send_ticket_message\",\n\t\t\t\targs: {\n\t\t\t\t\tticket: frm.doc.name,\n\t\t\t\t\ttemplate: \"valuation\",\n\t\t\t\t\tlang: lang,\n\t\t\t\t\tphone: destination,\n\t\t\t\t\ttext: text,\n\t\t\t\t},\n\t\t\t\tfreeze: true,\n\t\t\t\tfreeze_message: __(\"Sending…\"),\n\t\t\t\tcallback(r) {\n\t\t\t\t\tconst res = (r && r.message) || {};\n\n\t\t\t\t\tif (res.ok) {\n\t\t\t\t\t\tfrappe.show_alert(\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tmessage: __(\"Sent to {0}\", [res.phone || destination]),\n\t\t\t\t\t\t\t\tindicator: \"green\",\n\t\t\t\t\t\t\t},\n\t\t\t\t\t\t\t7\n\t\t\t\t\t\t);\n\t\t\t\t\t\tdialog.hide();\n\t\t\t\t\t\treturn;\n\t\t\t\t\t}\n\n\t\t\t\t\tfrappe.msgprint({\n\t\t\t\t\t\ttitle: __(\"Not sent\"),\n\t\t\t\t\t\tmessage: `${res.msg || __(\"Unknown error\")}<br><small>${__(\"code\")}: ${\n\t\t\t\t\t\t\tres.code || \"—\"\n\t\t\t\t\t\t}</small>`,\n\t\t\t\t\t\tindicator: \"red\",\n\t\t\t\t\t});\n\t\t\t\t},\n\t\t\t});\n\t\t}\n\t);\n}\n",
