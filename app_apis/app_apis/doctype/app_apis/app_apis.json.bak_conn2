 "fields": [
  {
   "description": "Account comes off the ticket, not from here — only the shared password below.",
   "fieldname": "sec_pilot",
   "fieldtype": "Section Break",
   "label": "Pilot Connection"
  },
  {
   "default": "https://ksa.pilot-gps.com/api/api.php",
   "description": "Pilot API endpoint.",
   "fieldname": "pilot_base_url",
   "fieldtype": "Data",
   "label": "Pilot Base URL"
  },
  {
   "default": "5",
   "description": "Wrong node answers “Invalid imei”.",
   "fieldname": "pilot_node",
   "fieldtype": "Data",
   "label": "Pilot Node"
  },
  {
   "description": "Used only when the ticket carries no pilot email.",
   "fieldname": "pilot_fallback_username",
   "fieldtype": "Data",
   "label": "Pilot Fallback Username"
  },
  {
   "fieldname": "col_pilot_a",
   "fieldtype": "Column Break"
  },
  {
   "description": "Shared password. site_config pilot_passwords wins.",
   "fieldname": "pilot_password",
   "fieldtype": "Password",
   "label": "Pilot Password"
  },
  {
   "default": "20",
   "fieldname": "pilot_request_timeout",
   "fieldtype": "Int",
   "label": "Pilot Request Timeout (seconds)"
  },
  {
   "default": "15",
   "fieldname": "pilot_stale_after_minutes",
   "fieldtype": "Int",
   "label": "Pilot Stale After (minutes)"
  },
  {
   "description": "One account for the whole site. Live reads, IMEI lookups only.",
   "fieldname": "sec_im",
   "fieldtype": "Section Break",
   "label": "IM Connection"
  },
  {
   "default": "https://gps.im2m.ws/webservice",
   "description": "IM webservice endpoint.",
   "fieldname": "im_base_url",
   "fieldtype": "Data",
   "label": "IM Base URL"
  },
  {
   "default": "37",
   "description": "Sent as ProjectId.",
   "fieldname": "im_project_id",
   "fieldtype": "Data",
   "label": "IM Project ID"
  },
  {
   "fieldname": "im_username",
   "fieldtype": "Data",
   "label": "IM Username"
  },
  {
   "description": "Case-sensitive.",
   "fieldname": "im_password",
   "fieldtype": "Password",
   "label": "IM Password"
  },
  {
   "fieldname": "col_im_a",
   "fieldtype": "Column Break"
  },
  {
   "default": "20",
   "fieldname": "im_request_timeout",
   "fieldtype": "Int",
   "label": "IM Request Timeout (seconds)"
  },
  {
   "default": "15",
   "fieldname": "im_stale_after_minutes",
   "fieldtype": "Int",
   "label": "IM Stale After (minutes)"
  },
  {
   "description": "Blank = System Timezone. Wrong value shifts “last seen” by hours.",
   "fieldname": "im_data_timezone",
   "fieldtype": "Data",
   "label": "IM Data Timezone (blank = system)"
  },
  {
   "fieldname": "col_im_b",
   "fieldtype": "Column Break"
  },
  {
   "default": "60",
   "description": "IM allows about one call a minute. Newer snapshots come from cache.",
   "fieldname": "im_min_call_interval_seconds",
   "fieldtype": "Int",
   "label": "IM Minimum Call Interval (seconds)"
  },
  {
   "default": "45",
   "description": "How long an access token is reused.",
   "fieldname": "im_token_ttl_minutes",
   "fieldtype": "Int",
   "label": "IM Token Cache TTL (minutes)"
  },
  {
   "default": "90",
   "description": "Must stay above the rate limit.",
   "fieldname": "im_ignition_poll_seconds",
   "fieldtype": "Int",
   "label": "IM Ignition Test Poll (seconds)"
  },
  {
   "default": "10",
   "fieldname": "im_ignition_window_minutes",
   "fieldtype": "Int",
   "label": "IM Ignition Test Window (minutes)"
  },
  {
   "description": "Nothing calls Chatwoot on its own. Run test_connection before enabling.",
   "fieldname": "sec_chatwoot",
   "fieldtype": "Section Break",
   "label": "Chatwoot Connection"
  },
  {
   "default": "0",
   "description": "Off = configure without sending. test_connection still works.",
   "fieldname": "chatwoot_enabled",
   "fieldtype": "Check",
   "label": "Chatwoot Enabled"
  },
  {
   "default": "https://app.chatwoot.com",
   "description": "Scheme and host only, e.g. https://chat.example.com",
   "fieldname": "chatwoot_base_url",
   "fieldtype": "Data",
   "label": "Chatwoot Domain"
  },
  {
   "description": "The number after /accounts/ in your Chatwoot URL.",
   "fieldname": "chatwoot_account_id",
   "fieldtype": "Data",
   "label": "Chatwoot Account ID"
  },
  {
   "description": "Decides the channel (WhatsApp / SMS / web). See list_inboxes.",
   "fieldname": "chatwoot_inbox_id",
   "fieldtype": "Data",
   "label": "Chatwoot Inbox ID"
  },
  {
   "fieldname": "col_chatwoot_a",
   "fieldtype": "Column Break"
  },
  {
   "description": "Chatwoot → Profile Settings → Access Token.",
   "fieldname": "chatwoot_api_token",
   "fieldtype": "Password",
   "label": "Chatwoot API Token"
  },
  {
   "default": "20",
   "fieldname": "chatwoot_request_timeout",
   "fieldtype": "Int",
   "label": "Chatwoot Request Timeout (seconds)"
  },
  {
   "default": "ar",
   "description": "Used when the Customer has no Print Language.",
   "fieldname": "chatwoot_default_language",
   "fieldtype": "Select",
   "label": "Chatwoot Default Language",
   "options": "ar\nen"
  },
  {
   "description": "English on the left, Arabic on the right, both in the order a job happens: accepted → work started → feedback. Placeholders: {ticket} {state} {customer} {engineer} {vehicle} {plate} {company} {link} {contacts}. {vehicle} is a whole line — “🚗 Vehicle: 1234 ABC” — and disappears, gap and all, for a customer who is not shown one; {plate} is the bare number, for your own wording.",
   "fieldname": "sec_chatwoot_messages",
   "fieldtype": "Section Break",
   "label": "Chatwoot Messages"
  },
  {
   "fieldname": "col_chatwoot_b",
   "fieldtype": "Column Break"
  },
  {
   "description": "Template “valuation”. Must include {link}.",
   "fieldname": "chatwoot_valuation_message_en",
   "fieldtype": "Small Text",
   "label": "Feedback Request (English)",
   "default": "Hello {customer} 👋\n\n✅ Your request {ticket} has been completed by {engineer}.\n\n⭐ We'd appreciate your feedback on our service — it takes less than a minute:\n\n🔗 {link}\n\n⏰ This link is valid for 24 hours.\n\nThank you for your trust 🙏"
  },
  {
   "description": "Template “valuation”, Arabic. Must include {link}.",
   "fieldname": "chatwoot_valuation_message_ar",
   "fieldtype": "Small Text",
   "label": "Feedback Request (Arabic)",
   "default": "مرحباً {customer} 👋\n\n✅ تم إنجاز طلبك رقم {ticket} بواسطة {engineer}.\n\n⭐ نسعد بتقييمك للخدمة، ولن يستغرق الأمر أكثر من دقيقة:\n\n🔗 {link}\n\n⏰ هذا الرابط صالح لمدة ٢٤ ساعة.\n\nشكراً لثقتكم بنا 🙏"
  },
  {
   "description": "Template “accepted”, English. Sent when the job is taken on.",
   "fieldname": "chatwoot_accepted_message_en",
   "fieldtype": "Small Text",
   "label": "Accepted Message (English)",
   "default": "Hello {customer} 👋\n\n✅ Your request {ticket} has been accepted.\n\n🔧 Installation Engineer: {engineer}\n\nWe will be in touch as soon as the work begins 🙏"
  },
  {
   "description": "Template “accepted”, Arabic.",
   "fieldname": "chatwoot_accepted_message_ar",
   "fieldtype": "Small Text",
   "label": "Accepted Message (Arabic)",
   "default": "مرحباً {customer} 👋\n\n✅ تم قبول طلبك رقم {ticket}.\n\n🔧 مهندس التركيب: {engineer}\n\nسنوافيكم فور بدء العمل 🙏"
  },
  {
   "description": "Template “working”, English. Sent when the engineer starts.",
   "fieldname": "chatwoot_working_message_en",
   "fieldtype": "Small Text",
   "label": "Work Started Message (English)",
   "default": "Hello {customer} 👋\n\n🛠️ Work on your request {ticket} is now under way.\n\n🔧 Installation Engineer: {engineer}\n\nWe will let you know as soon as it is complete 🙏"
  },
  {
   "description": "Template “working”, Arabic.",
   "fieldname": "chatwoot_working_message_ar",
   "fieldtype": "Small Text",
   "label": "Work Started Message (Arabic)",
   "default": "مرحباً {customer} 👋\n\n🛠️ العمل جارٍ الآن على طلبك رقم {ticket}.\n\n🔧 مهندس التركيب: {engineer}\n\nسنبلغكم فور الانتهاء 🙏"
  },
  {
   "collapsible": 1,
   "description": "Sent to the engineer assigned to the ticket, not to the customer. Same three stages, same two columns. These are work orders: they always carry the vehicle number whoever the customer is, and they never carry the feedback link. Placeholders: {ticket} {state} {customer} {engineer} {vehicle} {plate} {location} {phone} {company} {contacts}",
   "fieldname": "sec_tech_messages",
   "fieldtype": "Section Break",
   "label": "Technician Messages"
  },
  {
   "description": "Template “tech_accepted”, English. Sent when the job is assigned.",
   "fieldname": "tech_accepted_message_en",
   "fieldtype": "Small Text",
   "label": "Job Assigned (EN)"
  },
  {
   "description": "Template “tech_working”, English.",
   "fieldname": "tech_working_message_en",
   "fieldtype": "Small Text",
   "label": "Work Started (EN)"
  },
  {
   "description": "Template “tech_done”, English.",
   "fieldname": "tech_done_message_en",
   "fieldtype": "Small Text",
   "label": "Job Closed (EN)"
  },
  {
   "fieldname": "col_tech_b",
   "fieldtype": "Column Break"
  },
  {
   "description": "Template “tech_accepted”, Arabic.",
   "fieldname": "tech_accepted_message_ar",
   "fieldtype": "Small Text",
   "label": "Job Assigned (AR)"
  },
  {
   "description": "Template “tech_working”, Arabic.",
   "fieldname": "tech_working_message_ar",
   "fieldtype": "Small Text",
   "label": "Work Started (AR)"
  },
  {
   "description": "Template “tech_done”, Arabic.",
   "fieldname": "tech_done_message_ar",
   "fieldtype": "Small Text",
   "label": "Job Closed (AR)"
  },
  {
   "description": "Shown at the bottom of the feedback page and available to messages as {contacts}. Edit here or from a script — nothing is hardcoded.",
   "fieldname": "sec_contacts",
   "fieldtype": "Section Break",
   "label": "Contact Numbers"
  },
  {
   "fieldname": "contact_numbers",
   "fieldtype": "Table",
   "label": "Contact Numbers",
   "options": "App Apis Contact"
  },
  {
   "description": "Messages the customer on their own as a ticket moves through its statuses. Runs in the background — it can never delay or block a status change.",
   "fieldname": "sec_auto_messages",
   "fieldtype": "Section Break",
   "label": "Automatic Messages"
  },
  {
   "default": "0",
   "description": "Off means no customer is ever messaged by a status change. Governs the customer rules below and nothing else.",
   "fieldname": "auto_message_enabled",
   "fieldtype": "Check",
   "label": "Send to Customers"
  },
  {
   "default": "Individual",
   "description": "Only these customer types are messaged, comma separated. Write All to switch the filter off — blank falls back to Individual.",
   "fieldname": "auto_message_customer_types",
   "fieldtype": "Data",
   "label": "Customer Types"
  },
  {
   "default": "Individual",
   "description": "Who sees their vehicle number, in the message and on the feedback page. An individual owns the one car the visit was about; a company owns a fleet, so the plate tells its office contact nothing. Comma separated — All shows it to everyone, blank falls back to Individual.",
   "fieldname": "show_vehicle_customer_types",
   "fieldtype": "Data",
   "label": "Show Vehicle Number To"
  },
  {
   "fieldname": "col_auto_a",
   "fieldtype": "Column Break"
  },
  {
   "default": "0",
   "description": "Off means the engineer is never messaged. Independent of the customer switch — either side can run without the other — and deliberately not filtered by customer type: the engineer is being sent to do a job whoever owns the vehicle. They need a phone number on their User or Employee record; run app_apis.technicians.missing_numbers to see who has none.",
   "fieldname": "technician_message_enabled",
   "fieldtype": "Check",
   "label": "Send to Technicians"
  },
  {
   "default": "Auto",
   "description": "Auto reads the customer's own language, then falls back to the Chatwoot default. Technician messages ignore this reading of the customer and use the Chatwoot default.",
   "fieldname": "auto_message_language",
   "fieldtype": "Select",
   "label": "Language",
   "options": "Auto\nar\nen"
  },
  {
   "fieldname": "sec_auto_rules",
   "fieldtype": "Section Break",
   "label": "Status Rules"
  },
  {
   "description": "One row per stage: when the status becomes this, send that message. The tech_ templates go to the engineer and are governed by Send to Technicians; the rest go to the customer. Add, reorder or untick rows freely — nothing here is fixed in code.",
   "fieldname": "auto_message_rules",
   "fieldtype": "Table",
   "label": "Status Rules",
   "options": "App Apis Auto Message"
  }
 ],
